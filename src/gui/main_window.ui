  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #4f4f4f;
}

QPushButton {
    background-color: #538d4e; 
    color: white;
    border: none;
    border-radius: 5px;
    padding: 15% 10%;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6aaa64;
}

QPushButton#btn_exit {
    background-color: red;
	font-size: 10px;
}

QPushButton#btn_exit:hover {
    background-color: #818384;
}

QPushButton#btn_play, QPushButton#btn_leaderboard{
	font-size: 16px;
}

QLabel{
	color: #538d4e;
    font-weight: bold;
	qproperty-alignment: 'AlignHCenter | AlignVCenter'
}

QLabel#lbl_title{
	font-size: 60px;
}

QLabel#lbl_welcome{
	font-size: 20px;
}
</string>
